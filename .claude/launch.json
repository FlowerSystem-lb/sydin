{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sydin-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/sa219/sydinapp",
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "sydin-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/sa219/sydinapp",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    {
      "name": "sydin-prod-3000",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/sa219/sydinapp",
        "run",
        "start",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000,
      "env": {
        "NODE_OPTIONS": "--use-system-ca"
      }
    }
  ]
}
